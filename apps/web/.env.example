# FleetOS console — staging environment template (W092 [TL]).
#
# Copy to .env.local for local runs; set as Vercel project secrets for
# the staging deployment. NEVER commit real values; NEVER expose these
# to client-side bundles (the runtime consumes them at the server
# boundary only — see src/runtime/env.ts).
#
# The Vercel Hobby tier is NON-COMMERCIAL (development/staging/demo only).

# The deployment tier: development | staging | production
FLEETOS_ENV=staging

# The public base URL of the deployment (used by post-deploy checks + manifests)
FLEETOS_BASE_URL=

# Neon PostgreSQL (business truth — free tier staging project)
DATABASE_URL=
DATABASE_POOL_URL=

# Upstash Redis (queue/cache/lock ONLY — never domain truth)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 (evidence/artifacts — free tier staging bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
