{
  "name": "@payswapdotorg/fleetos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/integrations/*"
  ],
  "scripts": {
    "check:architecture": "node tools/check-architecture.mjs",
    "check:ownership": "node tools/check-ownership.mjs",
    "check:contracts": "node tools/check-contracts.mjs",
    "check:skeleton": "node tools/verify-skeleton.mjs",
    "check": "bun run check:architecture && bun run check:ownership && bun run check:contracts && bun run check:skeleton",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
